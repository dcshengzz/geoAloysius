<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GpsSync"
             x:DataType="local:ForgotPasswordViewModel"
             x:Class="GpsSync.ForgotPasswordPage"
             BackgroundColor="{StaticResource Primary}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="180,*">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8"
                             Padding="32,0">
            <Label Text="HitachiDispatch"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />
            <Label Text="RESET PASSWORD"
                   FontSize="11"
                   TextColor="#94A3B8"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Form card -->
        <ScrollView Grid.Row="1">
            <Frame CornerRadius="32"
                   Padding="28,32,28,40"
                   Margin="0"
                   HasShadow="False"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Forgot your password?"
                           FontSize="22"
                           FontAttributes="Bold"
                           Margin="0,0,0,4" />

                    <Label Text="Enter your email to receive a reset code, then enter the code and your new password below."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}" />

                    <!-- Email -->
                    <Label Text="Email address"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                           Margin="4,4,0,0" />
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#0F172A}"
                            Padding="4,2">
                        <Entry Text="{Binding Email}"
                               Placeholder="you@example.com"
                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#64748B}"
                               Keyboard="Email"
                               BackgroundColor="Transparent"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </Border>

                    <!-- Send Code button -->
                    <Button Text="Send Reset Code"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="14"
                            HeightRequest="48"
                            FontSize="15"
                            Command="{Binding SendCode}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <!-- Success message -->
                    <Label Text="{Binding SuccessMessage}"
                           TextColor="{StaticResource Success}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding CodeSent}" />

                    <!-- Code + new password section (shown after sending) -->
                    <VerticalStackLayout Spacing="14" IsVisible="{Binding CodeSent}">

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceBorderDark}}"
                                 Margin="0,4" />

                        <Label Text="Reset code"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                               Margin="4,0,0,0" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceBorderDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#0F172A}"
                                Padding="4,2">
                            <Entry Text="{Binding Code}"
                                   Placeholder="Enter code from email"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent" />
                        </Border>

                        <Label Text="New password"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                               Margin="4,0,0,0" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceBorderDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#0F172A}"
                                Padding="4,2">
                            <Entry Text="{Binding NewPassword}"
                                   Placeholder="••••••••"
                                   IsPassword="True"
                                   BackgroundColor="Transparent" />
                        </Border>

                        <Label Text="Confirm new password"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                               Margin="4,0,0,0" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceBorderDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#0F172A}"
                                Padding="4,2">
                            <Entry Text="{Binding ConfirmPassword}"
                                   Placeholder="••••••••"
                                   IsPassword="True"
                                   BackgroundColor="Transparent" />
                        </Border>

                        <Button Text="Set New Password"
                                BackgroundColor="{StaticResource Accent}"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="52"
                                FontSize="16"
                                FontAttributes="Bold"
                                Command="{Binding ResetPassword}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    </VerticalStackLayout>

                    <!-- Error -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Danger}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasError}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Accent}"
                                       HorizontalOptions="Center" />

                    <!-- Back to login -->
                    <Label Text="Back to Sign In"
                           FontSize="13"
                           TextDecorations="Underline"
                           TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                           HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateBack}" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>
