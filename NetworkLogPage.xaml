<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:gpssync="clr-namespace:GpsSync"
             x:DataType="gpssync:NetworkLogViewModel"
             x:Class="GpsSync.NetworkLogPage"
             Title="Network Events">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Filter" Command="{Binding ToggleFilter}" />
        <ToolbarItem Text="Clear" Command="{Binding Clear}" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout>

        <!-- Date Filter Panel -->
        <Frame IsVisible="{Binding IsFilterVisible}"
               Margin="12,8,12,0"
               Padding="12"
               CornerRadius="10"
               BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}">
            <VerticalStackLayout Spacing="8">
                <Label Text="Filter by Date" FontAttributes="Bold" FontSize="13" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="From:" VerticalOptions="Center" />
                    <DatePicker Grid.Column="1" Date="{Binding FromDate}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="To:" VerticalOptions="Center" />
                    <DatePicker Grid.Column="1" Date="{Binding ToDate}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Apply" Command="{Binding ApplyFilter}"
                            CornerRadius="8" HeightRequest="36" BackgroundColor="{StaticResource Primary}" TextColor="White" />
                    <Button Grid.Column="1" Text="Clear Filter" Command="{Binding ClearFilter}"
                            CornerRadius="8" HeightRequest="36" BackgroundColor="Transparent"
                            TextColor="{StaticResource Danger}" BorderColor="{StaticResource Danger}" BorderWidth="1" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <RefreshView Command="{Binding Load}"
                     IsRefreshing="{Binding IsBusy}"
                     VerticalOptions="FillAndExpand">
            <CollectionView ItemsSource="{Binding Logs}">
                <CollectionView.EmptyView>
                    <Label Text="No Network Events Recorded"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Margin="32" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gpssync:NetworkEvent">
                        <VerticalStackLayout Padding="16,10">
                            <Label Text="{Binding Timestamp.LocalDateTime, StringFormat='{0:MMM d, yyyy HH:mm:ss}'}"
                                   FontAttributes="Bold" FontSize="14" />
                            <Label FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasInternet}" Value="True">
                                        <Setter Property="Text" Value="Online" />
                                        <Setter Property="TextColor" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasInternet}" Value="False">
                                        <Setter Property="Text" Value="Offline" />
                                        <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding ConnectionTypes}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#444, Dark=#BBB}" />
                            <BoxView HeightRequest="1" HorizontalOptions="FillAndExpand"
                                     Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                                     Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Button Text="Load More"
                            Command="{Binding LoadMore}"
                            IsVisible="{Binding HasMore}"
                            Margin="16,8"
                            CornerRadius="8"
                            HeightRequest="40"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

    </VerticalStackLayout>
</ContentPage>
