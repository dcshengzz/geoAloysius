<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GpsSync"
             x:DataType="local:AdminJobsViewModel"
             x:Class="GpsSync.AdminJobsPage"
             Title="Job Board">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Clear Completed" Command="{Binding ClearCompleted}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding Load}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="16">

                <!-- Pending Jobs -->
                <Label Text="Pending"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                       Margin="0,16,0,8" />

                <Label Text="No pending jobs"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                       IsVisible="{Binding HasPending, Converter={StaticResource InvertedBoolConverter}}"
                       Margin="0,0,0,8" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingJobs}" Spacing="10"
                                     IsVisible="{Binding HasPending}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:AdminJobItem">
                            <Frame CornerRadius="12" Padding="14"
                                   BorderColor="#FFA500"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Frame Grid.Column="1" Padding="8,3" CornerRadius="6"
                                               BackgroundColor="#FFA500" HasShadow="False">
                                            <Label Text="Pending" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                        </Frame>
                                    </Grid>
                                    <Label Text="{Binding Description}" FontSize="13"
                                           TextColor="{AppThemeBinding Light=#6E6E6E, Dark=#ACACAC}"
                                           IsVisible="{Binding Description, Converter={x:Static local:StringNotEmptyConverter.Instance}}" />
                                    <Label Text="{Binding EngineerName, StringFormat='Engineer: {0}'}"
                                           FontSize="12" TextColor="{AppThemeBinding Light=#888, Dark=#888}" />
                                    <Label Text="{Binding CreatedAtLocal, StringFormat='Assigned: {0:dd MMM yyyy HH:mm}'}"
                                           FontSize="12" TextColor="{AppThemeBinding Light=#888, Dark=#888}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Separator -->
                <BoxView HeightRequest="1" Margin="0,16"
                         Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

                <!-- In Progress Jobs -->
                <Label Text="In Progress"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                       Margin="0,0,0,8" />

                <Label Text="No jobs in progress"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                       IsVisible="{Binding HasInProgress, Converter={StaticResource InvertedBoolConverter}}"
                       Margin="0,0,0,8" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding InProgressJobs}" Spacing="10"
                                     IsVisible="{Binding HasInProgress}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:AdminJobItem">
                            <Frame CornerRadius="12" Padding="14"
                                   BorderColor="#2196F3"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Frame Grid.Column="1" Padding="8,3" CornerRadius="6"
                                               BackgroundColor="#2196F3" HasShadow="False">
                                            <Label Text="In Progress" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                        </Frame>
                                    </Grid>
                                    <Label Text="{Binding Description}" FontSize="13"
                                           TextColor="{AppThemeBinding Light=#6E6E6E, Dark=#ACACAC}"
                                           IsVisible="{Binding Description, Converter={x:Static local:StringNotEmptyConverter.Instance}}" />
                                    <Label Text="{Binding EngineerName, StringFormat='Engineer: {0}'}"
                                           FontSize="12" TextColor="{AppThemeBinding Light=#888, Dark=#888}" />
                                    <Label Text="{Binding CreatedAtLocal, StringFormat='Assigned: {0:dd MMM yyyy HH:mm}'}"
                                           FontSize="12" TextColor="{AppThemeBinding Light=#888, Dark=#888}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Separator -->
                <BoxView HeightRequest="1" Margin="0,16"
                         Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

                <!-- Completed Jobs -->
                <Label Text="Completed"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                       Margin="0,0,0,8" />

                <Label Text="No completed jobs yet"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                       IsVisible="{Binding HasCompleted, Converter={StaticResource InvertedBoolConverter}}"
                       Margin="0,0,0,8" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CompletedJobs}" Spacing="10"
                                     IsVisible="{Binding HasCompleted}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:AdminJobItem">
                            <Frame CornerRadius="12" Padding="14"
                                   BorderColor="#4CAF50"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Frame Grid.Column="1" Padding="8,3" CornerRadius="6"
                                               BackgroundColor="#4CAF50" HasShadow="False">
                                            <Label Text="Completed" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                        </Frame>
                                    </Grid>
                                    <Label Text="{Binding Description}" FontSize="13"
                                           TextColor="{AppThemeBinding Light=#6E6E6E, Dark=#ACACAC}"
                                           IsVisible="{Binding Description, Converter={x:Static local:StringNotEmptyConverter.Instance}}" />
                                    <Label Text="{Binding EngineerName, StringFormat='Engineer: {0}'}"
                                           FontSize="12" TextColor="{AppThemeBinding Light=#888, Dark=#888}" />
                                    <Label Text="{Binding CreatedAtLocal, StringFormat='Assigned: {0:dd MMM yyyy HH:mm}'}"
                                           FontSize="12" TextColor="{AppThemeBinding Light=#888, Dark=#888}" />
                                    <Label Text="{Binding CompletedAtLocal, StringFormat='Completed: {0:dd MMM yyyy HH:mm}'}"
                                           FontSize="12" TextColor="#4CAF50" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <BoxView HeightRequest="24" Color="Transparent" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
