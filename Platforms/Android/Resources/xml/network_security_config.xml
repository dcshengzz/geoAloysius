<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allows cleartext (plain HTTP) traffic to the LOCAL DEV backend only.
        Android blocks cleartext HTTP by default, which is why login/register showed "network" errors.

        - Android emulator reaches the host machine via 10.0.2.2 (NOT localhost).
        - Genymotion uses 10.0.3.2.
        - For a PHYSICAL DEVICE, add your PC's LAN IP below, e.g.:
              <domain includeSubdomains="false">192.168.1.50</domain>
        Production should serve the API over HTTPS and drop these cleartext exceptions.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Tailscale: the "flux" box hosting the API (reachable from any tailnet device) -->
        <domain includeSubdomains="false">100.66.66.66</domain>
        <domain includeSubdomains="true">flux.tailcd8507.ts.net</domain>
        <!-- Same-machine Android emulator / local fallbacks -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
