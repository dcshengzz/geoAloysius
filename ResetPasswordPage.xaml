<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GpsSync"
             x:DataType="local:ResetPasswordViewModel"
             x:Class="GpsSync.ResetPasswordPage"
             Title="Reset Password"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="32" VerticalOptions="Center">

            <Label Text="Set New Password"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,40,0,0" />

            <Label Text="Enter and confirm your new password below."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,24" />

            <Entry Placeholder="New Password"
                   Text="{Binding NewPassword}"
                   IsPassword="True" />

            <Entry Placeholder="Confirm Password"
                   Text="{Binding ConfirmPassword}"
                   IsPassword="True" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Danger}"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding HasError}" />

            <Button Text="Save Password"
                    BackgroundColor="{StaticResource Success}"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Command="{Binding Save}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Success}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
