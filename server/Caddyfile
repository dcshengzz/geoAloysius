# Caddy fetches and renews a real HTTPS certificate for SITE_ADDRESS automatically
# (Let's Encrypt), as long as:
#   1. SITE_ADDRESS resolves (DNS) to THIS server's public IP, and
#   2. ports 80 and 443 are reachable from the internet.
#
# SITE_ADDRESS comes from server/.env, e.g.  api.yourcompany.com  or  34-87-120-9.sslip.io

{$SITE_ADDRESS} {
	reverse_proxy api:5080
}
