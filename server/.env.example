# Copy this file to server/.env (git-ignored) and fill in real values.
#
# ============================================================================
#  Docker Compose deployment (docker-compose.yml) — the PRIMARY path
#  `docker compose up -d --build` reads these three values.
# ============================================================================

# SQL Server 'sa' password. MUST be 8+ chars with upper, lower, digit AND a symbol.
SA_PASSWORD=Choose-A-Strong-Password-123!

# Secret used to sign JWTs. Long random string, >= 32 chars. Generate a fresh one:
#   openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Public address Caddy serves HTTPS on (and gets a Let's Encrypt cert for).
#   • With a domain:    api.yourcompany.com
#       -> create a DNS A record for it pointing at this server's public IP.
#   • No domain (free): <PUBLIC-IP-with-dashes>.sslip.io
#       -> e.g. if the public IP is 34.87.120.9  ->  34-87-120-9.sslip.io
#         (sslip.io resolves that name to 34.87.120.9 automatically — no DNS setup.)
SITE_ADDRESS=api.yourcompany.com


# ============================================================================
#  Alternative: running the API directly with `dotnet run` (no Docker), local dev.
#  Not used by docker compose. Load with:  set -a; source server/.env; set +a
# ============================================================================
# ConnectionStrings__Default="Server=localhost,1433;Database=GpsSync;User Id=sa;Password=Choose-A-Strong-Password-123!;TrustServerCertificate=True;Encrypt=False"
# Jwt__Key="replace-with-a-long-random-secret-at-least-32-chars"
