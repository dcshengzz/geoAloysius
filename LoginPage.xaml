<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GpsSync"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="local:LoginViewModel"
             x:Class="GpsSync.LoginPage"
             BackgroundColor="{StaticResource Primary}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="220,*">

        <!-- Branded header -->
        <VerticalStackLayout Grid.Row="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Fill"
                             Spacing="8"
                             Padding="32,0">
            <Label Text="HitachiDispatch"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />
            <Label Text="FIELD OPERATIONS PLATFORM"
                   FontSize="10"
                   TextColor="#94A3B8"
                   HorizontalTextAlignment="Center"
                   />
        </VerticalStackLayout>

        <!-- Form card -->
        <ScrollView Grid.Row="1">
            <Frame CornerRadius="32"
                   Padding="28,32,28,40"
                   Margin="0"
                   HasShadow="False"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">

                <VerticalStackLayout Spacing="14">

                    <Frame IsVisible="{Binding IsVerified}"
                           BackgroundColor="#DCFCE7"
                           BorderColor="#16A34A"
                           CornerRadius="10"
                           Padding="12,10"
                           Margin="0,0,0,4">
                        <Label Text="{Binding VerifiedMessage}"
                               TextColor="#15803D"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </Frame>

                    <Frame IsVisible="{Binding IsDisplaced}"
                           BackgroundColor="#FEF3C7"
                           BorderColor="#D97706"
                           CornerRadius="10"
                           Padding="12,10"
                           Margin="0,0,0,4">
                        <Label Text="{Binding DisplacedMessage}"
                               TextColor="#92400E"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </Frame>

                    <Label Text="Sign in to continue"
                           FontSize="22"
                           FontAttributes="Bold"
                           Margin="0,0,0,8" />

                    <!-- Email field -->
                    <Label Text="Email address"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                           Margin="4,0,0,0" />
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#0F172A}"
                            Padding="4,2">
                        <Entry Text="{Binding Email}"
                               Placeholder="you@example.com"
                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#64748B}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               Keyboard="Email"
                               BackgroundColor="Transparent"
                               AutomationId="EmailEntry" />
                    </Border>

                    <!-- Password field -->
                    <Label Text="Password"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                           Margin="4,0,0,0" />
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#0F172A}"
                            Padding="4,2">
                        <Entry Text="{Binding Password}"
                               Placeholder="••••••••"
                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#64748B}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               IsPassword="True"
                               BackgroundColor="Transparent"
                               AutomationId="PasswordEntry" />
                    </Border>

                    <!-- Error -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Danger}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasError}" />

                    <!-- Sign In -->
                    <Button Text="Sign In"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="White"
                            CornerRadius="14"
                            HeightRequest="52"
                            FontSize="16"
                            FontAttributes="Bold"
                            Command="{Binding Login}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="0,6,0,0" />

                    <!-- Forgot password -->
                    <Label Text="Forgot Password?"
                           FontSize="13"
                           TextDecorations="Underline"
                           TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}"
                           HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ForgotPassword}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Divider -->
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceBorderDark}}"
                             Margin="0,4" />

                    <!-- Create Account -->
                    <Button Text="Create Account"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Accent}"
                            BorderColor="{StaticResource Accent}"
                            BorderWidth="1.5"
                            CornerRadius="14"
                            HeightRequest="50"
                            FontSize="15"
                            Command="{Binding Register}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Accent}"
                                       HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>
        </ScrollView>

    </Grid>
</ContentPage>
