<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GpsSync"             
             x:Class="GpsSync.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/Templates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" />
<local:AllTrueMultiConverter x:Key="AllTrueMultiConverter" />
            <local:FilterChipBgConverter x:Key="FilterChipBgConverter" />
            <local:FilterChipTextConverter x:Key="FilterChipTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

